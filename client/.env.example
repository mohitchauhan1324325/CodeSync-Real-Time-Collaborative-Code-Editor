# ============================================================
# CodeSync Client — Environment Variables Template
# Copy this file to .env.local (do NOT prefix with VITE_ for secrets)
# ============================================================

# Backend API base URL (must match server PORT)
VITE_API_URL=http://localhost:5000/api

# Socket.io connection URL
VITE_SOCKET_URL=http://localhost:5000

# Production (after deploying server to Render/Railway):
# VITE_API_URL=https://your-codesync-api.onrender.com/api
# VITE_SOCKET_URL=https://your-codesync-api.onrender.com
