# ============================================================
# CodeSync — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/codesync
# Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codesync?retryWrites=true&w=majority

# --- JWT Auth ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# --- CORS ---
# Frontend origin (Vercel / local dev)
CLIENT_URL=http://localhost:5173

# --- Judge0 Code Execution (Optional) ---
# Register at https://rapidapi.com/judge0-official/api/judge0-ce
# Leave blank to use the local JavaScript sandbox fallback
JUDGE0_API_KEY=
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
